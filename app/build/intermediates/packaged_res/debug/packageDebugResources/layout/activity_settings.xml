<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ 설정"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="화면 테마"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp">

        <RadioButton android:id="@+id/rbThemeSystem" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🌓 시스템"/>
        <RadioButton android:id="@+id/rbThemeLight" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="☀️ 라이트"/>
        <RadioButton android:id="@+id/rbThemeDark" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🌙 다크"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="앱 글자 크기"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvFontPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="가나다 ABC 미리보기 문장입니다"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/seekFontScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="6"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="작게" android:textColor="@color/text_sub" android:textSize="10sp" android:gravity="start"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="보통" android:textColor="@color/text_sub" android:textSize="10sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="크게" android:textColor="@color/text_sub" android:textSize="10sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="아주크게" android:textColor="@color/text_sub" android:textSize="10sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="특대" android:textColor="@color/text_sub" android:textSize="10sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="거대" android:textColor="@color/text_sub" android:textSize="10sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="태블릿용" android:textColor="@color/text_sub" android:textSize="10sp" android:gravity="end"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22808080" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧩 홈 화면 위젯 꾸미기"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="배경 색상"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:id="@+id/rowWidgetColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="투명도"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekWidgetOpacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="90"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="글자 크기"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekWidgetFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="3"
        android:layout_marginBottom="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/widgetPreviewBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/widgetPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="미리보기"
                android:textColor="#1A1C1E"
                android:textSize="13sp"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22808080" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☁️ 구글 계정 동기화 (클라우드 백업)"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvLoginStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그인 상태: 비로그인"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnGoogleLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="구글 로그인"/>

        <Button
            android:id="@+id/btnCloudSync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="클라우드 동기화"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnApplySettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ 적용하기 (화면 새로고침)"/>

</LinearLayout>
</ScrollView>
