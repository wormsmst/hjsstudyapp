<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widgetBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#2962FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="🎲 미니 퀴즈"/>

            <TextView
                android:id="@+id/widgetQuizGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF6D00"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widgetQuizQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1A1C1E"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp"
            android:text="주제명과 퀴즈 질문"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/widgetChoice1"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#1A1C1E"
                android:background="@drawable/widget_background"
                android:text="보기 1"/>

            <Button
                android:id="@+id/widgetChoice2"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="4dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#1A1C1E"
                android:background="@drawable/widget_background"
                android:text="보기 2"/>

            <Button
                android:id="@+id/widgetChoice3"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:textColor="#1A1C1E"
                android:background="@drawable/widget_background"
                android:text="보기 3"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widgetQuizNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#2962FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:text="다음 문제 ▶"/>

    </LinearLayout>
</FrameLayout>
