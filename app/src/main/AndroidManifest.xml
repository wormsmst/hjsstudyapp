<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AdminMemoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AdminMemo"
        android:supportsRtl="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SubjectSelectActivity"
            android:exported="false"
            android:label="과목 선택" />

        <activity
            android:name=".ContentStudyListActivity"
            android:exported="false"
            android:label="본문학습" />

        <activity
            android:name=".OutlineDrillActivity"
            android:exported="false"
            android:label="목차학습" />

        <activity
            android:name=".ExamSessionActivity"
            android:exported="false"
            android:label="모의고사" />

        <activity
            android:name=".ExamPickActivity"
            android:exported="false"
            android:label="모의고사" />

        <activity
            android:name=".ContentDetailActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:label="본문 상세" />

        <activity
            android:name=".ContentManageHubActivity"
            android:exported="false"
            android:label="학습내용관리" />

        <activity
            android:name=".ContentManageActivity"
            android:exported="false"
            android:label="본문내용관리" />

        <activity
            android:name=".CaseContentManageActivity"
            android:exported="false"
            android:label="사례문제 관리" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="설정" />

        <activity
            android:name=".ExamSetupActivity"
            android:exported="false"
            android:label="모의고사 설정" />

        <activity
            android:name=".WrongNotesActivity"
            android:exported="false"
            android:label="오답노트" />

        <activity
            android:name=".ProgressActivity"
            android:exported="false"
            android:label="학습진도" />

        <activity
            android:name=".TodayTtsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="오늘의 TTS" />

        <activity
            android:name=".RecallActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:label="인출학습" />

        <activity
            android:name=".RecallPickActivity"
            android:exported="false"
            android:label="인출학습" />

        <activity
            android:name=".QuestActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:label="퀘스트" />

        <activity
            android:name=".OutlineFadeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:label="목차암기" />

        <service
            android:name=".StudyTtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".CardWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.adminmemo.ACTION_NEXT" />
                <action android:name="com.example.adminmemo.ACTION_CYCLE_MEMORY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".StudyWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>
