<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="인출학습"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="평소에는 한 과목만. 과목을 섞는 건 시험 직전과 모의고사 때."
            android:textColor="@color/text_sub"
            android:textSize="13sp"/>

        <include
            android:id="@+id/tvRecallPickCoach"
            layout="@layout/view_coach_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/tileRecallSubject"
                android:layout_width="0dp"
                android:layout_height="@dimen/recall_pick_tile_min"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/recall_pick_one"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="한 과목" android:textColor="@color/text_on_tile" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvRecallSubjectNext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="@color/text_on_tile"
                        android:textSize="12sp"
                        android:visibility="gone"/>
                </LinearLayout>
                <include android:id="@+id/tvRecallSubjectBadge" layout="@layout/view_tile_count_badge"/>
                <include android:id="@+id/tvRecallSubjectCont" layout="@layout/view_tile_continue"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/tileRecallAll"
                android:layout_width="0dp"
                android:layout_height="@dimen/recall_pick_tile_min"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/tile_today"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="전 과목" android:textColor="@color/text_on_tile" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvRecallAllSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="@color/text_on_tile" android:textSize="12sp" android:visibility="gone"/>
                </LinearLayout>
                <include android:id="@+id/tvRecallAllBadge" layout="@layout/view_tile_count_badge"/>
                <include android:id="@+id/tvRecallAllCont" layout="@layout/view_tile_continue"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/tileRecallPeriod1"
                android:layout_width="0dp"
                android:layout_height="@dimen/recall_pick_tile_min"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/tile_exam"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:minLines="2" android:text="1교시" android:textColor="@color/text_on_tile" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvRecallP1Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="민법 + 행정절차론" android:textColor="@color/text_on_tile" android:textSize="12sp"/>
                </LinearLayout>
                <include android:id="@+id/tvRecallP1Badge" layout="@layout/view_tile_count_badge"/>
                <include android:id="@+id/tvRecallP1Cont" layout="@layout/view_tile_continue"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/tileRecallPeriod2"
                android:layout_width="0dp"
                android:layout_height="@dimen/recall_pick_tile_min"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/tile_study"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:minLines="2" android:text="2교시" android:textColor="@color/text_on_tile" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvRecallP2Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="사무관리론 + 행정사실무법" android:textColor="@color/text_on_tile" android:textSize="12sp"/>
                </LinearLayout>
                <include android:id="@+id/tvRecallP2Badge" layout="@layout/view_tile_count_badge"/>
                <include android:id="@+id/tvRecallP2Cont" layout="@layout/view_tile_continue"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/tileRecallCase"
                android:layout_width="0dp"
                android:layout_height="@dimen/recall_pick_tile_min"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/tile_quiz"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:minLines="2" android:text="사례 인출" android:textColor="@color/text_on_tile" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvRecallCaseSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="결론 → 이유 → 목차" android:textColor="@color/text_on_tile" android:textSize="12sp"/>
                </LinearLayout>
                <include android:id="@+id/tvRecallCaseBadge" layout="@layout/view_tile_count_badge"/>
                <include android:id="@+id/tvRecallCaseCont" layout="@layout/view_tile_continue"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/tileRecallUnseen"
                android:layout_width="0dp"
                android:layout_height="@dimen/recall_pick_tile_min"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/tile_manage"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:minLines="2" android:text="이번 달 미인출" android:textColor="@color/text_on_tile" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvRecallUnseenSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:text="아직 한 번도 안 쓴 주제" android:textColor="@color/text_on_tile" android:textSize="12sp"/>
                </LinearLayout>
                <include android:id="@+id/tvRecallUnseenBadge" layout="@layout/view_tile_count_badge"/>
                <include android:id="@+id/tvRecallUnseenCont" layout="@layout/view_tile_continue"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
