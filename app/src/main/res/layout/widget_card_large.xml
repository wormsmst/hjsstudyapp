<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widgetBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <LinearLayout
        android:id="@+id/widgetRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/widgetHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/widgetGrade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6D00"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widgetMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#FFC107"
            android:textSize="12sp"
            android:text="○○○○○"/>

        <TextView
            android:id="@+id/widgetText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textColor="#1A1C1E"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:gravity="top"
            android:ellipsize="end"
            android:text="위젯을 탭하여 내용을 확인하세요"/>

        <TextView
            android:id="@+id/widgetNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#2962FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:text="스크롤 / 다음 내용 ▼"/>

    </LinearLayout>
</FrameLayout>
