<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDetailProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="1 / 1"/>

        <ImageButton
            android:id="@+id/btnSpeak"
            android:layout_width="@dimen/touch_icon"
            android:layout_height="@dimen/touch_icon"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="본문 듣기"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@color/primary"/>

        <ImageButton
            android:id="@+id/btnTtsVoice"
            android:layout_width="@dimen/touch_icon"
            android:layout_height="@dimen/touch_icon"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="목소리 선택"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/primary"/>

        <ImageButton
            android:id="@+id/btnEditDetail"
            android:layout_width="@dimen/touch_icon"
            android:layout_height="@dimen/touch_icon"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/primary"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutDetailSplit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layoutDetailLeftInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetailGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/text_main"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_gravity="center_vertical"
                        android:text="암기정도"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp"/>

                    <TextView android:id="@+id/star1" style="@style/MemoryStar"/>
                    <TextView android:id="@+id/star2" style="@style/MemoryStar"/>
                    <TextView android:id="@+id/star3" style="@style/MemoryStar"/>
                    <TextView android:id="@+id/star4" style="@style/MemoryStar"/>
                    <TextView android:id="@+id/star5" style="@style/MemoryStar"/>
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMnemonicBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EEF2FF">

                    <TextView
                        android:id="@+id/tvDetailMnemonic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvDetailBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:lineSpacingExtra="7dp"
                    android:letterSpacing="0.01"
                    android:textIsSelectable="true"/>
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/viewDetailGutter"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#22808080"
            android:visibility="gone"/>

        <ScrollView
            android:id="@+id/scrollDetailRight"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layoutDetailRightInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetailBodyRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:lineSpacingExtra="7dp"
                    android:letterSpacing="0.01"
                    android:textIsSelectable="true"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/layoutDetailTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="본문을 길게 눌러 문장을 선택한 뒤 Gemini에게 질문할 수 있어요."
                    android:textColor="@color/text_sub"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnAskGemini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:text="✨ Gemini에게 질문"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#22808080"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 내 메모"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etMemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top"
                    android:background="#14808080"
                    android:padding="12dp"
                    android:hint="이 주제에 대한 메모를 남겨보세요"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btnQuestWrite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/btn_min_height"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:text="종이에 1회 씀"/>

                <Button
                    android:id="@+id/btnSaveMemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="💾 메모 저장"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/bg_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevDetail"
                style="@style/Widget.AdminMemo.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:maxLines="1"
                android:ellipsize="none"
                android:text="◀ 이전"
                android:textAllCaps="false"
                android:textColor="@color/text_on_tile"
                app:backgroundTint="@color/btn_prev"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextDetail"
                style="@style/Widget.AdminMemo.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:maxLines="1"
                android:ellipsize="none"
                android:text="다음 ▶"
                android:textAllCaps="false"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
