<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="@string/app_name"
        android:textColor="@color/text_main"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="오늘도 한 걸음씩 📚"
        android:textColor="@color/text_sub"
        android:textSize="13sp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <androidx.cardview.widget.CardView android:id="@+id/tileStudy" android:minHeight="120dp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="6dp" android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📖" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="본문학습" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:id="@+id/tileOutline" android:minHeight="120dp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="6dp" android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗺️" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="목차학습" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:id="@+id/tileExam" android:minHeight="120dp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="6dp" android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="모의고사" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <androidx.cardview.widget.CardView android:id="@+id/tileQuiz" android:minHeight="120dp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="6dp" android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎲" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="학습퀴즈" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:id="@+id/tileManage" android:minHeight="120dp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="6dp" android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗂️" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="학습내용관리" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:id="@+id/tileSettings" android:minHeight="120dp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="6dp" android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="설정" android:textColor="@color/text_main" android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</LinearLayout>
</ScrollView>
