<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="학습진도"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/rowWeekNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="주간 학습량"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnWeekOlder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_week_nav_btn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/btn_min_height"
                android:minWidth="76dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="이전"
                android:textColor="@color/text_on_header"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnWeekNewer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_week_nav_btn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="@dimen/btn_min_height"
                android:minWidth="76dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="다음"
                android:textColor="@color/text_on_header"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWeekStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/tvProgressMastery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="과목별 암기 비중"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvProgressUnseenPace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_sub"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/layoutSubjectBars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"/>

        <LinearLayout
            android:id="@+id/layoutShareLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
