<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGeminiDragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="선택한 내용  ·  여기를 끌어 이동"
        android:textColor="@color/text_sub"
        android:textSize="13sp"/>

    <EditText
        android:id="@+id/etGeminiSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#14808080"
        android:gravity="top|start"
        android:hint="선택한 내용"
        android:inputType="textMultiLine"
        android:minHeight="144dp"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_sub"
        android:textSize="15sp"/>

    <EditText
        android:id="@+id/etGeminiQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="궁금한 점을 입력하세요"
        android:inputType="textMultiLine"
        android:minLines="2"/>

    <ProgressBar
        android:id="@+id/progressGemini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvGeminiAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/text_main"
        android:textSize="14sp"/>
</LinearLayout>
