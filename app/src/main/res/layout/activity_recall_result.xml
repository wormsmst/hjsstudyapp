<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="인출이 끝났습니다. 오늘 공부의 본모습은 막힌 장을 퀘스트에서 다시 쓰는 일입니다."
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRecallResultSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_main"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvRecallResultAchieved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <include
            android:id="@+id/tvRecallResultCoach"
            layout="@layout/view_coach_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="오늘의 퀘스트"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRecallResultQuests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/text_sub"
            android:textSize="14sp"/>

        <LinearLayout
            android:id="@+id/layoutRecallResultRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecallOpenMissed"
                style="@style/Widget.AdminMemo.Button.Row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="부족한 부분 채우기"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecallOpenTts"
                style="@style/Widget.AdminMemo.Button.Outlined.Row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="막힌 장 TTS로 듣기"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRecallResultRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecallOpenQuests"
                style="@style/Widget.AdminMemo.Button.Outlined.Row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="채운 장 다시 인출"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecallHome"
                style="@style/Widget.AdminMemo.Button.Outlined.Row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="홈으로"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
