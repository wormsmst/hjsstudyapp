<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ 설정"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:id="@+id/layoutSettingsSplit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☁️ Google 계정 · Firebase 동기화"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvAccountStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="로그인되어 있지 않아요"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnGoogleLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:text="Google로 로그인"/>

    <Button
        android:id="@+id/btnGoogleLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:text="로그아웃"/>

    <Button
        android:id="@+id/btnContentPush"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:text="본문 클라우드에 올리기"/>

    <Button
        android:id="@+id/btnContentPull"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:text="본문 클라우드에서 받기"/>

    <ProgressBar
        android:id="@+id/progressAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvSyncHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Google로 로그인하면 진도가 다른 기기와 맞춰집니다. 본문 수정은 아래 「올리기/받기」로만 옮깁니다."
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        android:layout_marginBottom="20dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎙️ 목소리 · 읽기"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="본문 듣기와 오늘의 TTS에 같이 쓰여요. 생각 시간, 신호음, 속도, 목소리를 여기서 고르세요."
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTtsSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:layout_marginBottom="20dp"
        android:text="목소리 · 속도 · 생각 시간"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22808080" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 메인 화면 디데이"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2차 시험일을 정하면 홈에 D-Day가 보여요. 1교시·2교시 과목은 그대로 둡니다."
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnPickExamDate1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:visibility="gone"
        android:text="1차 시험일 선택"/>

    <TextView
        android:id="@+id/tvExamDate1Picked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:text="1차 시험일을 아직 정하지 않았어요"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnPickExamDate2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:text="2차 시험일 선택"/>

    <TextView
        android:id="@+id/tvExamDate2Picked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:text="2차 시험일을 아직 정하지 않았어요"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22808080" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="홈 · 학습진도에 보여줄 숫자"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="둘 다 켜도 됩니다. 달성도는 모든 장의 암기정도를 5칸까지 채운 비율이고, 아직 인출하지 않은 장은 0입니다. 안정권은 암기정도 4칸 이상인 장의 비율입니다."
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbShowAchieve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:text="달성도"/>

    <CheckBox
        android:id="@+id/cbShowStable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/btn_min_height"
        android:layout_marginBottom="20dp"
        android:text="안정권"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22808080" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="화면 테마"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/rgTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp">

        <RadioButton android:id="@+id/rbThemeSystem" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🌓 시스템"/>
        <RadioButton android:id="@+id/rbThemeLight" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="☀️ 라이트"/>
        <RadioButton android:id="@+id/rbThemeDark" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🌙 다크"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="앱 글자 크기"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvFontPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="가나다 ABC 미리보기 문장입니다"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvFontScaleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:text="보통"/>

    <SeekBar
        android:id="@+id/seekFontScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="6"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="작게" android:textColor="@color/text_sub" android:textSize="11sp" android:gravity="start"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
            android:text="태블릿용 더 큰 단계 포함" android:textColor="@color/text_sub" android:textSize="11sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="최대" android:textColor="@color/text_sub" android:textSize="11sp" android:gravity="end"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22808080" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧩 홈 화면 위젯 꾸미기"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="배경 색상"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:id="@+id/rowWidgetColors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="투명도"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekWidgetOpacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="90"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="글자 크기"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <SeekBar
        android:id="@+id/seekWidgetFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="3"
        android:layout_marginBottom="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="90dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/widgetPreviewBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <TextView
                android:id="@+id/widgetPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="미리보기"
                android:textColor="#1A1C1E"
                android:textSize="13sp"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22808080" android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Gemini에게 질문하기"
        android:textColor="@color/text_main"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="본문에서 글을 드래그한 뒤, 반짝이 버튼으로 Gemini에게 물을 수 있습니다. API 키가 필요합니다."
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etGeminiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Gemini API 키 붙여넣기"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp"/>

    </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnApplySettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ 적용하기 (화면 새로고침)"/>

</LinearLayout>
</ScrollView>
