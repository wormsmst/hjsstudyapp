<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvFadeProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:textColor="@color/text_sub"
        android:textSize="13sp"/>

    <LinearLayout
        android:id="@+id/layoutFadeSplit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/tile_outline"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvFadeSubject"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_on_tile"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/tvFadeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:textColor="@color/text_on_tile"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <include
                    android:id="@+id/tvFadeCoach"
                    layout="@layout/view_coach_pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="horizontal">

                    <com.example.adminmemo.OutlineTreeView
                        android:id="@+id/viewFadeTree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvFadeStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_sub"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etFadeSentence"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:background="@color/bg_card"
                android:gravity="top"
                android:hint="제목만 보고 목차와 문장"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_sub"
                android:textSize="16sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvFadeAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFadeReveal"
                style="@style/Widget.AdminMemo.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="한 단계 열기"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFadeCheck"
                style="@style/Widget.AdminMemo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="대조"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFadeNext"
                style="@style/Widget.AdminMemo.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="다음 장"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
