<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AdminMemo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_screen</item>
    </style>

    <style name="MemoryStar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">☆</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
